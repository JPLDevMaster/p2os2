<?xml version="1.0"?>

<robot xmlns:xacro="http://ros.org/wiki/xacro">

  <xacro:include filename="$(find p2os_urdf)/defs/pioneer3dx_wheel.xacro"/>

  <!-- Chassis description -->
  <link name="base_link">
	<!-- CHECK THESE VALUES. THEY MAY BE COMPLETELY WRONG. -->
	<inertial>
	  <mass value="20.0"/>
	  <origin xyz="-0.045 0 0.148"/>
	  <inertia ixx="0.3338" ixy="0.0" ixz="0.0"
			   iyy="0.4783" iyz="0.0"
			   izz="0.3338"/>
	</inertial>
	<!-- The base visual is fine. Just the inertial is questionable.-->
	<visual>
	  <origin xyz="-0.045 0 0.148" rpy="0 0 0"/>
	  <geometry name="pioneer_geom">
		<mesh filename="package://p2os_urdf/meshes/p3dx_meshes/chassis.stl"/>
	  </geometry>
	  <material name="ChassisRed">
		<color rgba="0.851 0.0 0.0 1.0"/>
	  </material>
	</visual>
	<collision>
	  <origin xyz="-0.045 0 0.148" rpy="0 0 0"/>
	  <geometry>
        <box size="0.4 0.28 0.17"/>
        <!-- This is the correct bounding box, but x=0.43 crashes Gazebo? -->
		<!--box size="0.43 0.28 0.17"/-->
	  </geometry>
	</collision>
  </link>
  <gazebo reference="base_link">
	<material value="Gazebo/Red"/>
  </gazebo>

  <link name="top_plate">
	<inertial>
	  <mass value="0.01"/>	
	  <origin xyz="0 0 0"/>
	  <inertia ixx="1" ixy="0" ixz="0"
			   iyy="1" iyz="0"
 			   izz="1"/>
	</inertial>
	<visual>
	  <origin xyz="0 0 0" rpy="0 0 0"/>
	  <geometry name="pioneer_geom">
		<mesh filename="package://p2os_urdf/meshes/p3dx_meshes/top.stl"/>
	  </geometry>
	  <material name="TopBlack">
		<color rgba="0.038 0.038 0.038 1.0"/>
	  </material>
	</visual>
  </link>
  <gazebo reference="top_plate">
	<material value="Gazebo/Black"/>
  </gazebo>

  <joint name="base_top_joint" type="fixed">
	<origin xyz="-0.045 0 0.24" rpy="0 0 0"/>
	<parent link="base_link"/>
	<child link="top_plate"/>
  </joint>

  <!-- Swivel -->
  <link name="swivel">
	<inertial>
	  <mass value="0.1"/>	
	  <origin xyz="0 0 0"/>
	  <inertia ixx="0.01" ixy="0" ixz="0"
			   iyy="0.01" iyz="0" izz="0.01"/>
  	</inertial>
	<visual>
	  <origin xyz="0 0 0" rpy="0 0 0"/>
	  <geometry name="pioneer_geom">
		<mesh filename="package://p2os_urdf/meshes/p3dx_meshes/swivel.stl"/>
	  </geometry>
	  <material name="swivel">
		<color rgba="0.5 0.5 0.5 1"/>
	  </material>
	</visual>
  </link>
  <gazebo reference="swivel">
	<material value="Gazebo/Black"/>
  </gazebo>

  <joint name="base_swivel_joint" type="continuous">
	<origin xyz="-0.185 0 0.055" rpy="0 0 0"/>
	<axis xyz="0 0 1"/>
    <limit effort="100" velocity="100" k_velocity="0" />
    <joint_properties damping="0.0" friction="0.0" />
	<parent link="base_link"/>
	<child link="swivel"/>
  </joint>

  <!-- Center Wheel + Hubcap -->
  <link name="center_hubcap">
    <inertial>
	  <mass value="0.01"/>	
	  <origin xyz="0 0 0"/>
	  <inertia ixx="0.012411765597" ixy="-0.000711733678" ixz="0.00050272983"
			   iyy="0.015218160428" iyz="-0.000004273467" izz="0.011763977943"/>
  	</inertial>
	<visual>
	  <origin xyz="0 0 0" rpy="0 0 0"/>
	  <geometry name="pioneer_geom">
		<mesh filename="package://p2os_urdf/meshes/p3dx_meshes/center_hubcap.stl"/>
	  </geometry>
	  <material name="swivel">
		<color rgba="0.5 0.5 0.5 1"/>
	  </material>
	</visual>
  </link>
  <gazebo reference="center_hubcap">
	<material value="Gazebo/Black"/>
  </gazebo>

  <joint name="swivel_hubcap_joint" type="continuous">
	<origin xyz="-0.026 0 -0.016" rpy="0 0 0"/>
	<axis xyz="0 1 0"/>
	<anchor xyz="0 0 0"/>
    <limit effort="100" velocity="100" k_velocity="0" />
    <joint_properties damping="0.0" friction="0.0" />
	<parent link="swivel"/>
	<child link="center_wheel"/>
  </joint>

  <link name="center_wheel">
	<inertial>
	  <mass value="0.1"/>	
	  <origin xyz="0 0 0"/>
	  <inertia ixx="0.012411765597" ixy="-0.000711733678" ixz="0.00050272983"
			   iyy="0.015218160428" iyz="-0.000004273467" izz="0.011763977943"/>
  	</inertial>
	<visual>
	  <origin xyz="0 0 0" rpy="0 0 0"/>
	  <geometry name="pioneer_geom">
		<mesh filename="package://p2os_urdf/meshes/p3dx_meshes/center_wheel.stl"/>
	  </geometry>
	  <material name="WheelBlack">
		<color rgba="0.117 0.117 0.117 1"/>
	  </material>
	</visual>
	<collision>
	  <origin xyz="0 0 0" rpy="${-3.1415927/2.0} 0 0"/>
	  <geometry>
		<!--<mesh filename="package://p2os_urdf/meshes/p3dx_meshes/center_wheel.stl"/>-->
		<cylinder radius="0.0375" length="0.0314"/>
	  </geometry>
	</collision>
  </link>
  <gazebo reference="center_wheel">
	<material value="Gazebo/Black"/>
  </gazebo>

  <joint name="center_wheel_joint" type="fixed">
	<origin xyz="-0.0035 0 -0.001" rpy="0 0 0"/>
	<parent link="center_wheel"/>
	<child link="center_hubcap"/>
  </joint>

  <xacro:p3dx_wheel suffix="left" parent="base_link" reflect="1"/>
  <xacro:p3dx_wheel suffix="right" parent="base_link" reflect="-1"/>

  <!-- Front + Back Sonar ring visuals (decorative mesh only, not individual beam frames) -->
  <link name="front_sonar">
	<inertial>
	  <mass value="0.0001"/>	
	  <origin xyz="0 0 0"/>
	  <inertia ixx="1" ixy="0" ixz="0"
			   iyy="1" iyz="0" izz="1"/>
	</inertial>
	<visual>
	  <origin xyz="0 0 0" rpy="0 0 0"/>
	  <geometry name="pioneer_geom">
		<mesh filename="package://p2os_urdf/meshes/p3dx_meshes/front_sonar.stl"/>
	  </geometry>
	  <material name="SonarYellow">
		<color rgba="0.715 0.583 0.210 1.0"/>
	  </material>
	</visual>
  </link>
  <gazebo reference="front_sonar">
	<material value="Gazebo/Yellow"/>
  </gazebo>

  <joint name="base_front_joint" type="fixed">
	<origin xyz="-0.198 0 0.208" rpy="0 0 0"/>
	<parent link="base_link"/>
	<child link="front_sonar"/>
  </joint>

  <link name="back_sonar">
	<inertial>
	  <mass value="0.0001"/>	
	  <origin xyz="0 0 0"/>
	  <inertia ixx="1" ixy="0" ixz="0"
			   iyy="1" iyz="0" izz="1"/>
	</inertial>
	<visual>
	  <origin xyz="0 0 0" rpy="0 0 0"/>
	  <geometry name="pioneer_geom">
		<mesh filename="package://p2os_urdf/meshes/p3dx_meshes/back_sonar.stl"/>
	  </geometry>
	  <material name="SonarYellow">
		<color rgba="0.715 0.583 0.210 1.0"/>
	  </material>
	</visual>
  </link>

  <gazebo reference="back_sonar">
	<material value="Gazebo/Yellow"/>
  </gazebo>

  <joint name="base_back_joint" type="fixed">
	<origin xyz="0.109 0 0.209" rpy="0 0 0"/>
	<!-- <origin xyz="0 0 0" rpy="0 0 0"/> -->
	<parent link="base_link"/>
	<child link="back_sonar"/>
  </joint>

  <!--
    Individual sonar beam frames — one per transducer.

    These are the coordinate frames that Range messages reference via their
    header.frame_id (sonar_N_link). TI believe they must exist in the TF tree 
	for RViz2 to position and orient the sonar cones correctly.

    Positions and yaw angles are taken directly from p3dx_params in
    robot_params.cpp (the ARIA parameter file for this robot model). The
    format there is {x_mm, y_mm, yaw_degrees} measured from the robot centre
    with x-forward / y-left convention, which maps directly to base_link.

    z is 0.208m to match the sonar ring height already established by the
    front_sonar and back_sonar joint origins above. base_link is at ground
    level in this URDF (confirmed by the wheel joints at z=0.091m = wheel
    radius), so 0.208m is the correct height off the ground.

    The macro takes no visual geometry, these are pure coordinate frames.
    front_sonar and back_sonar above already provide the ring mesh visuals.

    NOTE: If an 8-sonar Pioneer variant is running, sonar_0 through
    sonar_7 will receive Range messages and sonar_8 through sonar_15 will
    be silent. All 16 TF frames are published regardless, the cost is negligible
    and this way the same URDF works on both variants without modification.
  -->
  <xacro:property name="SONAR_Z" value="0.208"/>

  <xacro:macro name="sonar_frame" params="index x_m y_m yaw_rad">
    <link name="sonar_${index}_link"/>
    <joint name="sonar_${index}_joint" type="fixed">
      <origin xyz="${x_m} ${y_m} ${SONAR_Z}" rpy="0 0 ${yaw_rad}"/>
      <parent link="base_link"/>
      <child  link="sonar_${index}_link"/>
    </joint>
  </xacro:macro>

  <!-- Sonar positions from p3dx_params -> x_mm/1000, y_mm/1000, yaw_deg*pi/180 -->
  <!-- Front arc (sonars 0-7, x positive = in front of robot centre) -->
  <xacro:sonar_frame index="0"  x_m=" 0.115" y_m=" 0.130" yaw_rad=" 1.5708"/>
  <xacro:sonar_frame index="1"  x_m=" 0.155" y_m=" 0.115" yaw_rad=" 0.8727"/>
  <xacro:sonar_frame index="2"  x_m=" 0.190" y_m=" 0.080" yaw_rad=" 0.5236"/>
  <xacro:sonar_frame index="3"  x_m=" 0.210" y_m=" 0.025" yaw_rad=" 0.1745"/>
  <xacro:sonar_frame index="4"  x_m=" 0.210" y_m="-0.025" yaw_rad="-0.1745"/>
  <xacro:sonar_frame index="5"  x_m=" 0.190" y_m="-0.080" yaw_rad="-0.5236"/>
  <xacro:sonar_frame index="6"  x_m=" 0.155" y_m="-0.115" yaw_rad="-0.8727"/>
  <xacro:sonar_frame index="7"  x_m=" 0.115" y_m="-0.130" yaw_rad="-1.5708"/>
  <!-- Rear arc (sonars 8-15, x negative = behind robot centre) -->
  <xacro:sonar_frame index="8"  x_m="-0.115" y_m="-0.130" yaw_rad="-1.5708"/>
  <xacro:sonar_frame index="9"  x_m="-0.155" y_m="-0.115" yaw_rad="-2.2689"/>
  <xacro:sonar_frame index="10" x_m="-0.190" y_m="-0.080" yaw_rad="-2.6180"/>
  <xacro:sonar_frame index="11" x_m="-0.210" y_m="-0.025" yaw_rad="-2.9671"/>
  <xacro:sonar_frame index="12" x_m="-0.210" y_m=" 0.025" yaw_rad=" 2.9671"/>
  <xacro:sonar_frame index="13" x_m="-0.190" y_m=" 0.080" yaw_rad=" 2.6180"/>
  <xacro:sonar_frame index="14" x_m="-0.155" y_m=" 0.115" yaw_rad=" 2.2689"/>
  <xacro:sonar_frame index="15" x_m="-0.115" y_m=" 0.130" yaw_rad=" 1.5708"/>

	<gazebo>
		<plugin
			filename="gz-sim-diff-drive-system"
			name="gz::sim::systems::DiffDrive">
			<updateRate>100.0</updateRate>
			<robotNamespace>/</robotNamespace>
			<num_wheel_pairs>1</num_wheel_pairs>
			<left_joint>base_left_wheel_joint</left_joint>
			<right_joint>base_right_wheel_joint</right_joint>
			<wheel_separation>0.32</wheel_separation>
			<wheel_diameter>0.18</wheel_diameter>
			<robotBaseFrame>base_link</robotBaseFrame>
			<torque>5</torque> <!-- TODO: Check this value (per wheel or total?) -->
			<topicName>cmd_vel</topicName>
		</plugin>
	</gazebo>
</robot>
